	(text "ESP32-S3-WROOM-1U-N16R8 (16 MB flash, 8 MB octal PSRAM, U.FL antenna connector)"
		(exclude_from_sim no)
		(at 182.1235 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "f2984344-bdb4-5684-a922-1d2c9f18bd15")
	)
	(text "3V3 at the module"
		(exclude_from_sim no)
		(at 30.4655 25.4 0)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "67645c21-b5ea-5de6-95ad-6cfea0e8e547")
	)
	(text "EN: power-up delay, never floating"
		(exclude_from_sim no)
		(at 41.954 63.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "846ee3b6-fbad-5802-a7cf-21cc7351163e")
	)
	(text "USB D+/D- (module IO20/IO19)"
		(exclude_from_sim no)
		(at 40.5383 116.84 0)
		(effects
			(font
				(size 1.8 1.8)
			)
		)
		(uuid "3dd8013e-cd9e-5ac0-80cd-b83f924f3e3e")
	)
	(text "ESP32-S3-WROOM-1U-N16R8 (Espressif, C3013946): Wi-Fi on, its antenna a flex antenna on a U.FL cable"
		(exclude_from_sim no)
		(at 251.5819 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c873b7d4-704a-54b4-81f0-4f122bc2597d")
	)
	(text "(no antenna on the board). IO35-IO37 are the octal PSRAM's. Strapping pins: IO0 BOOT, IO3 SR_DATA (JTAG source,"
		(exclude_from_sim no)
		(at 255.0611 24.13 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "ceb62c61-d370-5d34-a5f7-6ece4ba6dcbd")
	)
	(text "ignored), IO45 AMP_EN (low at reset: R37) and IO46 CHG_OFF (low: R44). IO43/IO44 are UART0: LCD_D5/D6 toggle with"
		(exclude_from_sim no)
		(at 257.1471 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "22ceeebb-b95a-5002-a362-9a8dfac5faec")
	)
	(text "the ROM's boot log while LCD_WR stays still. USB D-/D+ on IO19/IO20 (series 22 ohm, caps to ground not fitted)."
		(exclude_from_sim no)
		(at 255.2135 31.75 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a9ff2079-6f82-5db0-a1f3-5d9d6c8b685a")
	)
