  (text "QD3525 3.5in IPS panel (ST7796U, 4-line SPI). Its 48-pin FPC folds under the panel and is soldered to J3."
    (at 162.56 15 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "5cba8308-0a4c-42ba-bc70-621541398988"))

  (text "Unused bus pins are tied as the panel maker's own module ties them: DB0-17 and RGB low, RD and IM2-0 high."
    (at 162.56 19 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "896fa552-9bb6-47a7-9174-8d880fcd8fe8"))

  (text "U6 AP3156 sinks each of the six backlight LEDs; current set over SDI (1-wire, 32 steps, 20 mA max each)."
    (at 161.29 23 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "00949f64-1cc1-44f2-9784-e5253bbcfc56"))

