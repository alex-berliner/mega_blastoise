  (text "QD3525 3.5in IPS panel (ST7796U, 4-line SPI). Its 48-pin FPC folds under the panel and is soldered to J3."
    (at 162.56 15 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "72e5f462-c15d-45da-9a63-53e526e10ed5"))

  (text "Unused bus pins are tied as the panel maker's own module ties them: DB0-17 and RGB low, RD and IM2-0 high."
    (at 162.56 19 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "2265337d-29f4-4183-b195-ae5f9685e4e3"))

