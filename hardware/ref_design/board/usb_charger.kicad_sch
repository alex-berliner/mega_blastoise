  (text "TP4056 charges at 500 mA (R5), from 1 to 46 C (TH1 over the cell). USB feeds the system through D5;"
    (at 63.5 185 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "8f886a9a-1294-4869-9cde-28f858a7a9e9"))

  (text "without USB the cell does, through Q2; on an unplug D7 carries VSYS until R38 has drained VBUS and Q2 is on."
    (at 68.58 189 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "495d0a54-0e8f-4266-9b16-beda8c779fbb"))

  (text "CC1/CC2_SENSE let firmware read the source's current offer (dim the backlight on a 500 mA port)."
    (at 62.23 193 0)
    (effects
      (font
        (size 1.27 1.27)))
    (uuid "c2c96b55-b06e-4acf-9b6e-14eefc0cdebd"))

