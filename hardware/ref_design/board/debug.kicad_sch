    (effects (font (size 1.27 1.27)))
    (uuid "ed181698-e8cb-4283-9d3d-e96680d90edd")
  )
  (text "cell out and nothing on USB; BOOTSEL to GND at reset enters the USB boot loader, RUN to GND resets."
