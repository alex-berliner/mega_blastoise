#!/bin/sh
# Keeps the assembly viewer on GitHub Pages in step with the design: when main is pushed and
# viewer/site/parts is older than the board or case it was built from, rebuild it, commit
# it, and stop the push so the next push carries it. Installed as .git/hooks/pre-push:
#   ln -s ../../hardware/ref_design/viewer/pre-push .git/hooks/pre-push
top=$(git rev-parse --show-toplevel)
v="$top/hardware/ref_design/viewer"
[ -f "$v/build.py" ] || exit 0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  python3 "$v/build.py" --check >/dev/null && exit 0
  if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
    echo "pre-push: the assembly viewer is out of date. Check out the commit being pushed,"
    echo "run python3 hardware/ref_design/viewer/build.py, commit viewer/site, and push again."
    exit 1
  fi
  echo "pre-push: rebuilding the assembly viewer for GitHub Pages..."
  python3 "$v/build.py" || exit 1
  git add "$v/site" && git commit -q -m "Assembly viewer: rebuild for $(git rev-parse --short HEAD)" -- "$v/site" || exit 1
  echo "pre-push: committed the rebuilt viewer ($(git rev-parse --short HEAD)). Push again to include it."
  exit 1
done
exit 0
