# vendor datasheets are not ours to redistribute: datasheets/SOURCES.md says where each comes from
datasheets/*.pdf
datasheets/*.txt
datasheets/*.png
!datasheets/RPI-RP2350B-MINIMAL_LICENSE.txt
**/__pycache__/
# KiCad per-user and generated state
board/*.kicad_prl
board/*-backups/
board/fp-info-cache
board/~*.lck
board/_autosave-*
board/#auto_saved_files#
# routing scratch (the session itself, last_route.ses, is kept for --reuse)
board/tools/freerouting.log
board/tools/last_route.dsn
board/_repair.*
# KiCad reports and local history (File > Local History), and its restore backups
board/*-erc.rpt
board/*-drc.rpt
board/.history/
board/_restore_backup_*/
# vendor SPICE models: board/sim/models.py fetches and translates them
board/sim/models/
