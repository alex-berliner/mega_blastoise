# vendor datasheets are not ours to redistribute: datasheets/SOURCES.md says where each comes from
datasheets/*.pdf
datasheets/*.txt
datasheets/*.png
!datasheets/RPI-RP2350B-MINIMAL_LICENSE.txt
**/__pycache__/
# KiCad per-user and generated state
board/*.kicad_prl
board/*-backups/
board/fp-info-cache
board/~*.lck
board/_autosave-*
board/#auto_saved_files#
# routing scratch (the session itself, last_route.ses, is kept for --reuse)
board/tools/freerouting.log
board/tools/last_route.dsn
board/_repair.*
# KiCad reports and local history (File > Local History), and its restore backups
board/*-erc.rpt
board/*-drc.rpt
board/.history/
board/_restore_backup_*/
# vendor SPICE models: board/sim/models.py fetches and translates them
board/sim/models/
# build output: every file below comes back from the rebuild pipeline in README.md, so only
# what can't be regenerated (the routed board, the schematics, the 3D viewer that Pages serves,
# hand-made print projects, images the docs show) is kept (Alex, 2026-10-19)
board/fab/gerbers/
board/fab/battler_gerbers.zip
board/fab/battler.step
board/fab/battler_bom_jlc.csv
board/fab/battler_cpl_jlc.csv
board/fab/battler_schematic.pdf
board/fab/battler_assembly.pdf
board/fab/drc.txt
case/tub.stl
case/top.stl
case/board.dxf
case/positions.json
case/fit_report.txt
case/fitkit/*.stl
case/print/package_U1/
case/print/package_P1S/
case/print/mega_blastoise_print_U1.zip
case/print/mega_blastoise_print_P1S.zip
case/print/tests_U1/
case/print/tests_P1S/
case/print/overhang_kit.zip
.build/
