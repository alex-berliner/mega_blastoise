  (text "J1 pin order is ASSUMED: 1=GND 2=VCC 3=SCL/SCK 4=SDA/MOSI 5=RES 6=DC 7=CS 8=BLK. VERIFY against the module silkscreen before soldering."
    (at 150 30 0)
    (effects
      (font
        (size 1.6 1.6)))
    (uuid "e7a484f1-a4c2-4dd5-a29f-c72dee83d81e"))

  (text "All 16 buttons are direct-to-GPIO, active low, internal pull-ups. No matrix, no diodes: ghosting is impossible by construction."
    (at 150 34 0)
    (effects
      (font
        (size 1.6 1.6)))
    (uuid "ee78e69f-6c32-4087-9c9b-e17267ca9230"))

  (text "Power: the charger's USB-C and the Pico's micro-USB may be plugged in at the same time."
    (at 100 166 0)
    (effects
      (font
        (size 1.6 1.6)))
    (uuid "712448e2-dd65-4fd6-8e07-1327b228791e"))

  (text "VBUS reaches VSYS through the Pico's own Schottky, the cell reaches it through D1; the higher rail wins and neither back-feeds the other."
    (at 100 170 0)
    (effects
      (font
        (size 1.6 1.6)))
    (uuid "dc3f758e-2be2-448d-99a9-382ce37454a6"))

